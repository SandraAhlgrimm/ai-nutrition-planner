{
  "name": "AI Nutrition Planner",
  "image": "mcr.microsoft.com/devcontainers/java:25",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "jdkDistro": "ms",
      "installMaven": "true",
      "mavenVersion": "3.9.13"
    }
  },
  "forwardPorts": [8080, 3000, 4317, 4318],
  "portsAttributes": {
    "8080": { "label": "App" },
    "3000": { "label": "Grafana" },
    "4317": { "label": "OTLP gRPC" },
    "4318": { "label": "OTLP HTTP" }
  },
  "secrets": {
    "OPENAI_API_KEY": {
      "description": "OpenAI API key used by the default 'openai' Spring profile"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot",
        "GitHub.copilot"
      ]
    }
  }
}
