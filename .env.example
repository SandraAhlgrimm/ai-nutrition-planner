# Copy this file to .env and fill in the values for your preferred AI provider
# Run: cp .env.example .env && set -a && source .env && set +a

# --- OpenAI (default profile) ---
SPRING_PROFILES_ACTIVE=openai
OPENAI_API_KEY=your-api-key-here

# --- Microsoft Foundry / Azure OpenAI ---
# SPRING_PROFILES_ACTIVE=azure
# AZURE_OPENAI_BASEURL=https://your-resource.openai.azure.com/openai/v1
# AZURE_OPENAI_API_KEY=your-api-key-here
