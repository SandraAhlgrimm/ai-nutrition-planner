# Copy this file to .env and fill in values for one AI provider.
# Run from the repository root: cp .env.example .env
# Spring Boot does not load .env automatically. Export it before starting Maven:
# set -a; . ./.env; set +a

# --- OpenAI (activate only one provider profile) ---
SPRING_PROFILES_ACTIVE=openai
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL_NAME=gpt-4o

# --- Azure OpenAI (use SPRING_PROFILES_ACTIVE=azure) ---
# SPRING_PROFILES_ACTIVE=azure
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# --- Ollama local LLM (use SPRING_PROFILES_ACTIVE=ollama) ---
# SPRING_PROFILES_ACTIVE=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL_NAME=qwen2.5
